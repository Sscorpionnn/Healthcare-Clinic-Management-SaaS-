{
  "name": "clinic-management-saas",
  "private": true,
  "version": "0.1.0",
  "description": "Multi-tenant, privacy-first clinic management platform.",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "test:e2e": "pnpm --filter web run test:e2e",
    "db:generate": "pnpm --filter @clinic/database run generate",
    "db:migrate": "pnpm --filter @clinic/database run migrate",
    "db:seed": "pnpm --filter @clinic/database run seed",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ]
  }
}
