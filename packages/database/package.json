{
  "name": "@clinic/database",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "rls:apply": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/rls.sql",
    "roles:apply": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f prisma/roles.sql",
    "seed": "tsx prisma/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clinic/shared": "workspace:*",
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@types/node": "^22.10.2",
    "prisma": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
