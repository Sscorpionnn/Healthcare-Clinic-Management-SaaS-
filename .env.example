# Copy to .env and fill in local values. Never commit the real .env file.
# All values below are non-secret placeholders for local development only.

# ---- Postgres ----
POSTGRES_USER=clinic_app
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=clinic_management
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL="postgresql://clinic_app:change-me-locally@localhost:5432/clinic_management?schema=public"
# Separate role used only by SUPER_ADMIN platform operations (BYPASSRLS). Never used for tenant data access.
DATABASE_URL_PLATFORM="postgresql://clinic_platform:change-me-locally@localhost:5432/clinic_management?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Object storage (S3-compatible, MinIO locally) ----
STORAGE_ENDPOINT=localhost
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_ACCESS_KEY=clinic_storage
STORAGE_SECRET_KEY=change-me-locally
STORAGE_BUCKET_PRIVATE=clinic-documents
STORAGE_BUCKET_QUARANTINE=clinic-documents-quarantine
STORAGE_SIGNED_URL_TTL_SECONDS=300

# ---- Auth ----
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
COOKIE_DOMAIN=localhost
CSRF_SECRET=replace-with-a-long-random-value

# ---- App ----
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Field-level encryption (AES-256-GCM key, 32-byte base64) ----
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# ---- Email (Mailhog locally) ----
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Clinic Platform <no-reply@clinic.local>"

# ---- Rate limiting ----
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
